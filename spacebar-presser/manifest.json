{
  "manifest_version": 3,
  "name": "Auto Spacebar Presser",
  "version": "1.0.0",
  "description": "Presses Space at a fresh random interval (default 20-60s) in a tab you pick. Single or musical-chairs (paired) mode. Cryptographic randomness.",
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Auto Spacebar Presser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
